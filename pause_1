    # ----- ChatBot Screen -----
    def send_message(self):
        user_input = self.root.ids.user_input.text
        if not user_input.strip():
            return
        self.add_message_bubble(user_input, is_user=True)
        self.root.ids.user_input.text = ""
        self.root.ids.chat_scroll.scroll_y = 0

        # Add loading indicator
        self.loading_widget = self.add_message_bubble("AgroBot is typing...", is_user=False, loading=True)
        threading.Thread(target=self.get_bot_response, args=(user_input,), daemon=True).start()
    
    def get_bot_response(self, user_input):
        lang_instruction = "Respond in Tamil" if self.current_lang == "ta" else "Respond in English"
        response = self.chatbot.get_response(f"{lang_instruction}\n{user_input}", self.chat_history)

        def update_ui(dt):
            if hasattr(self, "loading_widget") and self.loading_widget:
                if self.loading_widget.parent:
                    self.loading_widget.parent.remove_widget(self.loading_widget)
            self.add_message_bubble(response, is_user=False)
        Clock.schedule_once(update_ui)

        self.chat_history.append({"role": "user", "content": user_input[:1000]})
        self.chat_history.append({"role": "assistant", "content": response[:1000]})

    def add_message_bubble(self, text, is_user, loading=False):
        bubble_layout = MDBoxLayout(
            size_hint_y=None,
            adaptive_height=True,
            padding=(dp(10), dp(8)),
            spacing=dp(10)
        )
        card = MDCard(
            size_hint_x=0.9,
            size_hint_y=None,
            adaptive_height=True,
            padding=dp(15),
            radius=[20, 20, 5, 20] if not is_user else [20, 20, 20, 5],
            md_bg_color=(0.12, 0.12, 0.12, 1) if not is_user else (0.1, 0.6, 0.3, 1),
            elevation=3
        )
        formatted_text = self.format_markdown_for_kivy(text)
        label = MDLabel(
            text=formatted_text,
            markup=True,
            size_hint_y=None,
            halign="left",
            theme_text_color="Custom",
            text_color=(1, 1, 1, 1)
        )
        label.bind(
            width=lambda instance, value: setattr(instance, "text_size", (value, None))
        )
        label.bind(
            texture_size=lambda instance, value: setattr(instance, "height", value[1])
        )
        card.add_widget(label)
        if is_user:
            bubble_layout.add_widget(MDBoxLayout())  # spacer
            bubble_layout.add_widget(card)
        else:
            bubble_layout.add_widget(card)
            bubble_layout.add_widget(MDBoxLayout())  # spacer
        self.root.ids.chat_list.add_widget(bubble_layout)
        self.root.ids.chat_scroll.scroll_y = 0
        if loading:
            return bubble_layout

    def format_markdown_for_kivy(self, text):
        text = re.sub(r"^### (.*)", r"\n[b][size=20]\1[/size][/b]\n", text, flags=re.MULTILINE)
        text = re.sub(r"\*\*(.*?)\*\*", r"[b]\1[/b]", text)
        text = re.sub(r"---", "\n[color=#555555]────────────────────────[/color]\n", text)
        lines = text.split("\n")
        new_lines = []
        for line in lines:
            if "|" in line and not line.strip().startswith("---"):
                parts = [p.strip() for p in line.split("|") if p.strip()]
                if len(parts) > 1:
                    formatted = "\n• " + "  |  ".join(parts)
                    new_lines.append(formatted)
                else:
                    new_lines.append(line)
            else:
                new_lines.append(line)
        return "\n".join(new_lines)

