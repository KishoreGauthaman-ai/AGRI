    def init_onnx(self):
        self.class_names = [
            "Pepper__bell___Bacterial_spot",
            "Pepper__bell___healthy",
            "Potato___Early_blight",
            "Potato___Late_blight",
            "Potato___healthy",
            "Tomato_Bacterial_spot",
            "Tomato_Early_blight",
            "Tomato_Late_blight",
            "Tomato_Leaf_Mold",
            "Tomato_Septoria_leaf_spot",
            "Tomato_Spider_mites_Two_spotted_spider_mite",
            "Tomato__Target_Spot",
            "Tomato__Tomato_YellowLeaf__Curl_Virus",
            "Tomato__Tomato_mosaic_virus",
            "Tomato_health"
        ]
        BASE_DIR = os.path.dirname(os.path.abspath(__file__))
        model_path = os.path.join(BASE_DIR, "model.onnx")
        if not os.path.exists(model_path):
            raise FileNotFoundError(f"ONNX model not found at: {model_path}")
        self.session = ort.InferenceSession(model_path, providers=["CPUExecutionProvider"])
        self.input_name = self.session.get_inputs()[0].name
        print("✅ ONNX model loaded successfully")

    def preprocess_image(self, image_path):
        image = Image.open(image_path).convert("RGB")
        image = image.resize((224, 224))
        img = np.array(image).astype("float32") / 255.0
        mean = np.array([0.485, 0.456, 0.406], dtype="float32")
        std = np.array([0.229, 0.224, 0.225], dtype="float32")
        img = (img - mean) / std
        img = np.transpose(img, (2, 0, 1))
        img = np.expand_dims(img, axis=0)
        return img

    def analyze_leaf(self):
        if not hasattr(self, "session"):
            self.init_onnx()
        if not hasattr(self, "selected_image") or not self.selected_image:
            self.root.ids.result_label.text = self.t("error_upload")
            return
        threading.Thread(target=self._analyze_leaf_worker, daemon=True).start()

    def _analyze_leaf_worker(self):
        try:
            input_image = self.preprocess_image(self.selected_image).astype(np.float32)
            outputs = self.session.run(None, {self.input_name: input_image})
            logits = outputs[0]
            logits = logits - np.max(logits, axis=1, keepdims=True)
            exp = np.exp(logits)
            probabilities = exp / np.sum(exp, axis=1, keepdims=True)
            predicted = int(np.argmax(probabilities, axis=1)[0])
            confidence = float(probabilities[0][predicted])
            raw_label = self.class_names[predicted]
            confidence_percent = round(confidence * 100, 2)
            cleaned = raw_label.replace("___", " - ").replace("__", " - ").replace("_", " ")
            if " - " in cleaned:
                plant, disease = cleaned.split(" - ", 1)
            else:
                plant = "Plant"
                disease = cleaned
            if self.current_lang == "ta":
                # Tamil output
                result_text = (
                    f"[b][color=#1bb56b]{self.t('leaf_output_plant')}:[/color][/b] {plant}\n"
                    f"[b][color=#1bb56b]{self.t('leaf_output_disease')}:[/color][/b] {disease}\n"
                    f"[b][color=#1bb56b]{self.t('leaf_output_confidence')}:[/color][/b] {confidence_percent}%"
                )
            else:
                # English output
                result_text = (
                    f"[b][color=#1bb56b]{self.t('leaf_output_plant')}:[/color][/b] {plant}\n"
                    f"[b][color=#1bb56b]{self.t('leaf_output_disease')}:[/color][/b] {disease}\n"
                    f"[b][color=#1bb56b]{self.t('leaf_output_confidence')}:[/color][/b] {confidence_percent}%"
                )
            Clock.schedule_once(lambda dt: self.update_result(result_text))
            dummy = f"Plant: {plant}\nDisease: {disease}\nConfidence: {confidence_percent}%"
            self.chat_history.append({"role": "user", "content": dummy})
            response = self.chatbot.get_response(dummy, self.chat_history)
            self.chat_history.append({"role": "assistant", "content": str(response[:1000])})
            print("Chatbot Response:\n", response)
        except Exception as e:
            traceback.print_exc()
            error_msg = f"Error analyzing image:\n{str(e)}"
            Clock.schedule_once(lambda dt: self.update_result(error_msg))

    def update_result(self, text):
        self.root.ids.result_label.markup = True
        self.root.ids.result_label.text = text

    # Profit calculation
    def calculate_profit(self):
        try:
            crop = self.root.ids.profit_crop.text
            area = float(self.root.ids.profit_area.text)
            yield_per_acre = float(self.root.ids.profit_yield.text)
            price = float(self.root.ids.profit_price.text)
            cost = float(self.root.ids.profit_cost.text)
            production = yield_per_acre * area * 1000  # convert to kg
            revenue = production * price
            profit = revenue - cost
            margin = (profit / revenue) * 100 if revenue != 0 else 0
            if self.current_lang == "ta":
                result = (
                    f"[b]{self.t('profit_output_crop')}:[/b] {crop}\n"
                    f"[b]{self.t('profit_output_prod')}:[/b] {round(production,2)} kg\n"
                    f"[b]{self.t('profit_output_revenue')}:[/b] ₹{round(revenue,2)}\n"
                    f"[b]{self.t('profit_output_cost')}:[/b] ₹{round(cost,2)}\n"
                    f"[b]{self.t('profit_output_profit')}:[/b] ₹{round(profit,2)}\n"
                    f"[b]{self.t('profit_output_margin')}:[/b] {round(margin,2)}%"
                )
            else:
                result = (
                    f"[b]{self.t('profit_output_crop')}:[/b] {crop}\n"
                    f"[b]{self.t('profit_output_prod')}:[/b] {round(production,2)} kg\n"
                    f"[b]{self.t('profit_output_revenue')}:[/b] ₹{round(revenue,2)}\n"
                    f"[b]{self.t('profit_output_cost')}:[/b] ₹{round(cost,2)}\n"
                    f"[b]{self.t('profit_output_profit')}:[/b] ₹{round(profit,2)}\n"
                    f"[b]{self.t('profit_output_margin')}:[/b] {round(margin,2)}%"
                )
            self.root.ids.profit_result.text = result
        except ValueError:
            self.root.ids.profit_result.text = self.t("error_valid")
        except Exception as e:
            self.root.ids.profit_result.text = f"Error: {str(e)}"

