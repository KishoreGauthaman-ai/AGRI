    # Weather fetching
    def get_weather(self):
        city = self.root.ids.city_field.text
        if not city:
            self.show_error(self.t("enter_city_error"))
            return

        self.root.ids.search_btn.text = self.t("get_weather") + "..."
        Clock.schedule_once(lambda dt: self._fetch_weather(city), 0.1)
    
    def _fetch_weather(self, city):
        data = WeatherAPI.get_weather(city)
        self.root.ids.search_btn.text = self.t("get_weather")

        if "error" in data:
            self.show_error(data["error"])
        else:
            # Update labels with localization
            self.temperature = f"{data['temp']}°C"
            if self.current_lang == "ta":
                self.humidity = f"{self.t('humidity_label')} {data['humidity']}%"
                self.wind = f"{self.t('wind_label')} {data['wind_speed']} km/h"
                self.feels_like = f"{self.t('feels_like')} {data['feels_like']}"
                self.sea_level = f"{self.t('sea_level')} {data['sea_level']}"
            else:
                self.humidity = f"{data['humidity']}%"
                self.wind = f"{data['wind_speed']} km/h"
                self.feels_like = f"{self.t('feels_like')} {data['feels_like']}"
                self.sea_level = f"{self.t('sea_level')} {data['sea_level']}"
            self.condition = data['condition']
            self.coord = f"The Coordinates are {data['coord']}"
            self.data = f"The whole datas are {data['data']}"
            self.bot_processing()


            

